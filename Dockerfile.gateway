# syntax=docker/dockerfile:1.7
# Gateway image: Hono API gateway only — no Next build, no dashboard assets.
# Shares the repo (open-sse/, src/sse/, src/lib/, src/domain/, src/shared/)
# plus node_modules for runtime deps. Small, fast to build, independent of
# dashboard releases.
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
FROM ${NODE_IMAGE} AS builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

FROM ${NODE_IMAGE} AS gateway

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Runtime deps only (skip devDependencies for a lean image)
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/node_modules/node-machine-id ./node_modules/node-machine-id

# Gateway runtime code: Hono server + shims + the pipeline it serves
COPY gateway ./gateway
COPY open-sse ./open-sse
COPY src ./src

ENV NODE_ENV=production
ENV GATEWAY_PORT=3778
ENV HOSTNAME=0.0.0.0
ENV DATA_DIR=/app/data

RUN mkdir -p /app/data && chown -R node:node /app/data

USER node

EXPOSE 3778

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3778/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Alias resolver is registered programmatically at top of gateway/server.js
CMD ["node", "--max-old-space-size=2048", "gateway/server.js"]
