# AxonRouter environment contract
# This file reflects actual runtime usage in the current codebase.
# scripts/install.sh auto-generates all secrets below — you normally never edit this by hand.

# ── Required ────────────────────────────────────────────────────────────────
# Session cookie signing key (auto-generated: 64-char hex)
JWT_SECRET=change-me-to-a-long-random-secret
# Initial dashboard admin password (auto-generated: 16-char hex; change after first login)
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/axonrouter

# ── Runtime ────────────────────────────────────────────────────────────────
PORT=3777
NODE_ENV=production

# ── Security & ops ─────────────────────────────────────────────────────────
# HMAC secret for gateway API tokens (auto-generated: 64-char hex)
API_KEY_SECRET=endpoint-proxy-api-key-secret
# Salt for machine-id derivation (auto-generated: 32-char hex)
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# Prometheus metrics: scrape GET /metrics (port 3777) or GET /metrics (port 3778).
# No extra config needed — text exposition format 0.0.4, public path.
# Payload capture for request_details rows:
#   bounded (default) = clamp prompt/response text to 32KB + redact bearer/api-key patterns
#   none              = metadata only (tokens, latency, status); nothing from prompts/responses
#   full              = store raw payloads unclamped (legacy behavior, no redaction)
PAYLOAD_STORAGE_MODE=bounded
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# ── Gateway Worker Mode (Hono API Gateway on port 3778) ────────────────────
# GATEWAY_CLUSTER:
#   true  (default) = multi-worker cluster using node:cluster. Handles heavy agent traffic.
#   false           = single standalone process. Lowest memory usage for small VPS / 1 CPU.
GATEWAY_CLUSTER=true
# Number of cluster worker processes (clamped to available CPU cores).
# The one-line installer defaults to 4; gateway/server.js falls back to all cores when unset/auto.
GATEWAY_WORKERS=4
# ── Routing & scale tuning ─────────────────────────────────────────────────
# LKG_TTL_S: last-known-good account cache TTL in seconds. Lower (5-10) spreads load across accounts. Default: 60.
LKG_TTL_S=10
# ROUTING_MAX_CANDIDATE_WINDOWS: candidate windows (500 accounts each) scanned before declaring exhausted. Default: 6 (3,000 accounts).
ROUTING_MAX_CANDIDATE_WINDOWS=6
# Background OAuth token refresh delays (ms) between accounts.
BG_REFRESH_DELAY_MS=1000
BG_REFRESH_GOOGLE_DELAY_MS=6000

# ── Database (Pure PostgreSQL 17) ──────────────────────────────────────────
# In Docker, compose overrides host -> postgres service automatically.
# NOTE: For managed PG (Neon, Supabase, RDS), always use DIRECT connection.
# DO NOT use transaction poolers / PgBouncer (-pooler or port 6543).
DATABASE_URL=postgres://axonrouter:password123@localhost:5432/axonrouter
# PG connection pool size; match MAX_CONCURRENT_UPSTREAM on big boxes (default 25)
PG_POOL_MAX=25
# AES-256-GCM master key for credential envelope encryption (hex 64-char; auto-generated)
# Generate manually with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# PostgreSQL password (auto-generated: 32-char hex; DATABASE_URL above is re-synced by the installer)
POSTGRES_PASSWORD=password123

# ── Cloud sync ─────────────────────────────────────────────────────────────
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Both are read server-side AND inlined into the dashboard bundle at build time.
BASE_URL=http://localhost:3777
CLOUD_URL=https://axonrouter.com

# ── Outbound proxy (optional) ──────────────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── SearXNG web-search provider (optional) ─────────────────────────────────
# SEARXNG_URL=http://searxng:8080/search

# ── Reference only (not read by runtime) ───────────────────────────────────
# INSTANCE_NAME=axonrouter

# ── Proxy egress geo probe ─────────────────────────────────────────────────
# The Proxy Fitness "Geo probe" toggle is a runtime setting too; these are the
# hard overrides for the background scheduler sampling pool egress IP+country.
# POOL_GEO_PROBE_DISABLED=1        # 1 = never run the geo probe
# GEO_PROBE_URL=                   # optional single custom endpoint (replaces the built-in 4-endpoint chain)
